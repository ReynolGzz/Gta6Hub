// ViceHub database schema.
// Dev provider is SQLite for zero-config local runs. For production, switch
// `provider` to "postgresql" and point DATABASE_URL at Supabase/Postgres.
// The schema avoids native enums and scalar arrays so it stays portable across
// both providers (array-like fields are stored as JSON strings).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Content ────────────────────────────────

model Car {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  summary             String
  imageUrl            String?
  category            String // Super | Sports | Muscle | SUV | Bikes | Boats | Aircraft
  topSpeed            Float // mph
  acceleration        Float // 0-100 score
  braking             Float // 0-100 score
  handling            Float // 0-100 score
  price               Int // in-game $
  location            String?
  unlockMethod        String?
  realLifeInspiration String?
  relatedIds          String   @default("[]") // JSON array of car ids
  popularity          Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([category])
  @@index([topSpeed])
  @@index([price])
}

model MoneyMethod {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  summary            String
  imageUrl           String?
  category           String // Solo | Co-op | Passive | Heist | Business
  profitPerHour      Int
  difficulty         String // Easy | Medium | Hard
  requiredInvestment Int      @default(0)
  playersRequired    Int      @default(1)
  timeNeeded         String? // e.g. "20-40 min"
  riskLevel          String // Low | Medium | High
  popularity         Int      @default(0)
  soloFriendly       Boolean  @default(true)
  beginnerFriendly   Boolean  @default(true)
  guide              String // markdown
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([profitPerHour])
  @@index([difficulty])
}

// Generic content entity used for the remaining 11 types. The `type`
// discriminator + JSON `data` field keep a single flexible table that the
// shared list/detail templates render via lib/entities.ts.
model Entity {
  id         String   @id @default(cuid())
  type       String // weapon | business | property | mission | character | crew | location | activity | race | easter-egg | achievement | collectible
  slug       String
  name       String
  summary    String
  imageUrl   String?
  category   String?
  data       String   @default("{}") // JSON of type-specific fields
  lat        Float?
  lng        Float?
  popularity Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([type, slug])
  @@index([type])
}

// Map markers — denormalized points usable across categories.
model MapMarker {
  id         String  @id @default(cuid())
  category   String // cars | businesses | weapons | properties | collectibles | secrets | missions
  name       String
  description String?
  lat        Float
  lng        Float
  entityType String?
  entitySlug String?

  @@index([category])
}

// ──────────────────────────── Auth & Users ──────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             String    @default("USER") // USER | ADMIN
  plan             String    @default("FREE") // FREE | PREMIUM
  stripeCustomerId String?
  stripeSubId      String?
  createdAt        DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  progress        Progress[]
  builds          Build[]
  votes           Vote[]
  comments        Comment[]
  saved           SavedLocation[]
  giveawayEntries GiveawayEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────── Tracking & Community ─────────────────────────

model Progress {
  id         String   @id @default(cuid())
  userId     String
  entityType String // cars | weapons | properties | story | achievements | collectibles ...
  entityId   String
  status     String   @default("DONE") // DONE | IN_PROGRESS
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
}

model Build {
  id        String   @id @default(cuid())
  userId    String
  type      String // collection | route | portfolio | loadout
  name      String
  notes     String?
  itemIds   String   @default("[]") // JSON array
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic])
}

model Vote {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  value      Int      @default(1) // +1 / -1
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId])
}

model Comment {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  body       String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

model SavedLocation {
  id        String   @id @default(cuid())
  userId    String
  name      String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────── Giveaways / Prizes ────────────────────────────
// Site-run giveaways (e.g. game keys, in-game cash, merch, Nitro). A public
// hub that drives recurring traffic; signed-in users enter and earn bonus
// entries for community actions (joining Discord, sharing).
model Giveaway {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  prize       String // headline prize, e.g. "GTA 6 + $20M in-game cash"
  summary     String
  description String // markdown details + rules
  imageUrl    String?
  prizeValue  Int      @default(0) // approx USD value, for sorting/badges
  status      String   @default("ACTIVE") // ACTIVE | ENDED | UPCOMING
  featured    Boolean  @default(false)
  startsAt    DateTime @default(now())
  endsAt      DateTime
  winnerName  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries GiveawayEntry[]

  @@index([status])
  @@index([endsAt])
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveawayId String
  userId     String
  entries    Int      @default(1) // weighted: +bonus for Discord/share actions
  bonusJoinedDiscord Boolean @default(false)
  bonusShared        Boolean @default(false)
  createdAt  DateTime @default(now())

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
  @@index([giveawayId])
}
