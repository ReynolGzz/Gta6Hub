# ──────────────────────────────────────────────────────────────────────────
# ViceHub environment. EVERYTHING here is OPTIONAL for local development.
# The app boots and runs with zero configuration; integrations degrade
# gracefully when their keys are absent. Copy to `.env` to customize.
# ──────────────────────────────────────────────────────────────────────────

# Database — defaults to a local SQLite file. For production, point this at a
# Supabase / Postgres connection string and switch the provider in
# prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# NextAuth — a random secret is fine for dev; set a strong one in production.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-me"

# OpenAI (AI assistant). Without it, the RAG assistant answers from the
# database using a templated retrieval response instead of an LLM.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Mapbox (interactive map). Without it, the map renders a styled placeholder
# with the marker list still fully usable.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Stripe (premium tier). Without it, premium is reachable in a clearly-marked
# dev/free mode and checkout returns a friendly message.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# PostHog (product analytics). No-op when unset.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Public site URL (used by SEO / sitemaps).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
